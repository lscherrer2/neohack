# Copy to packing/service/.env (git-ignored) and fill in. Leave blank to disable.
# Private API key (Vapi dashboard > API Keys), used to place callback calls:
VAPI_API_KEY=
# Vapi phone number id to call FROM (must support outbound; free Vapi numbers can't):
VAPI_PHONE_NUMBER_ID=
# Assistant that speaks on the callback; its prompt can use {{order_id}} {{customer_name}} {{items}}:
VAPI_CALLBACK_ASSISTANT_ID=
# Same value as the credential on your Vapi server URL (sent as X-Vapi-Secret or Bearer):
VAPI_SERVER_SECRET=
# Bearer token for the /orders admin endpoints (blank = no auth; local only):
ADMIN_TOKEN=
